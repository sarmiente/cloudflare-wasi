---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';

import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ShareThis from '../components/buttons/ShareThis.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);


type Props = CollectionEntry<'blog'>['data'];


const { title, heroImage, pubDate } = Astro.props;
---

<Layout title={title}>
  <section class="bg-gray-50 py-24">
    <div class="mx-auto max-w-screen-lg px-4 py-16">

      <div class="space-y-6 text-center">
        <p class="font-pattern font-medium capitalizr">{pubDate.toDateString()}</p>
        <h1 class="text-3xl lg:text-5xl font-heading mb-4 text-gray-900">{title}</h1>
       <a href="http://sarpinagency.com" target="_blank">
          <div class="font-pattern uppercase block sm:inline text-xs pb-5 md:p-0">
            <span class="text-black">sarpin</span> <span class="text-sky-700 uppercase">agency</span>
          </div>
        </a>
      </div>
      <!-- Imagen destacada -->
      {heroImage && (
        <div class="py-5 flex justify-center items-center">
          <img
            src={heroImage}
            alt={title}
            class="rounded-lg w-2/3 max-w-full h-80 object-cover"
          />
        </div>
      )}


      <!-- Contenido del post -->
      <article class="prose prose-lg max-w-none mx-auto">
        <slot />
      </article>
    </div>
    
  <ShareThis />
  </section>

  
</Layout>

			
