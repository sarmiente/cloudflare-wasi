---
import Layout from "../layouts/Layout.astro";

import CenteredHero from "../components/sections/CenteredHero.astro"
import CTA from "../components/sections/CTA.astro"



import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Hero from "../components/sections/Hero.astro";
import ForSale from "../components/sections/ForSale.astro";
import ForRent from "../components/sections/ForRent.astro";
import PromoBanner from "../components/sections/PromoBanner.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<Layout title=`${t("layout.title")}`>
    <Hero title={t("hero.title")} description={t("hero.desc")} />
    <ForSale />
    <ForRent />
    <CenteredHero />
    <CTA  />
    <PromoBanner  description="Descubre apartamentos y casas en venta con asesoría inmobiliaria profesional." image="/br_front_04.svg" />
    
</Layout>
